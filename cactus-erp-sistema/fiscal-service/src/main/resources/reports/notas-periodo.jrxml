<?xml version="1.0" encoding="UTF-8"?>
<!--
  Template escrito à mão como XML puro (ver ANÁLISE: MÓDULO DE RELATÓRIOS no CLAUDE.md
  raiz — formato clássico do JasperReports 6.x, compatível com Jaspersoft Studio).
  Campos ($F{...}) = componentes do record NotaFiscalPeriodoItemResponse (projeção
  achatada unificando NF-e/NFC-e/NFS-e/CT-e, ver RelatorioFiscalService). situacao (enum)
  chega como String (Enum->name() genérico); dataEmissao (Instant) vira java.util.Date.
  Paisagem: 6 colunas, mas com margem generosa pro "Tipo" (3-5 caracteres, destacado).
-->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="notas-periodo" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="782"
              leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20" whenNoDataType="AllSectionsNoDetail"
              uuid="c9d0e1f2-e5f6-4081-0a9c-041526374859">

    <parameter name="P_TITULO" class="java.lang.String">
        <defaultValueExpression><![CDATA["Notas Emitidas por Período"]]></defaultValueExpression>
    </parameter>
    <parameter name="P_PERIODO" class="java.lang.String"/>
    <parameter name="P_FILTRO" class="java.lang.String"/>
    <parameter name="P_DATA_GERACAO" class="java.lang.String"/>

    <field name="tipoDocumento" class="java.lang.String"/>
    <field name="numero" class="java.lang.String"/>
    <field name="serie" class="java.lang.String"/>
    <!-- Convertido de java.time.Instant pra java.util.Date pelo ReportEngine. -->
    <field name="dataEmissao" class="java.util.Date"/>
    <field name="situacao" class="java.lang.String"/>
    <field name="valorTotal" class="java.math.BigDecimal"/>

    <variable name="V_TOTAL_VALOR" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{valorTotal}]]></variableExpression>
        <initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression>
    </variable>

    <title>
        <band height="80">
            <staticText>
                <reportElement x="0" y="0" width="782" height="24"/>
                <textElement><font size="16" isBold="true"/></textElement>
                <text><![CDATA[Cactus ERP]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="26" width="782" height="18"/>
                <textElement><font size="12" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{P_TITULO}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="46" width="550" height="14"/>
                <textElement><font size="9"/></textElement>
                <textFieldExpression><![CDATA["Período: " + $P{P_PERIODO} + "   |   " + $P{P_FILTRO}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="550" y="46" width="232" height="14"/>
                <textElement textAlignment="Right"><font size="9"/></textElement>
                <textFieldExpression><![CDATA["Gerado em: " + $P{P_DATA_GERACAO}]]></textFieldExpression>
            </textField>
            <line><reportElement x="0" y="66" width="782" height="1"/></line>
        </band>
    </title>

    <columnHeader>
        <band height="20">
            <staticText>
                <reportElement x="0" y="0" width="80" height="20" backcolor="#EFEFEF" mode="Opaque"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Tipo]]></text>
            </staticText>
            <staticText>
                <reportElement x="80" y="0" width="150" height="20" backcolor="#EFEFEF" mode="Opaque"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Número]]></text>
            </staticText>
            <staticText>
                <reportElement x="230" y="0" width="80" height="20" backcolor="#EFEFEF" mode="Opaque"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Série]]></text>
            </staticText>
            <staticText>
                <reportElement x="310" y="0" width="140" height="20" backcolor="#EFEFEF" mode="Opaque"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Data Emissão]]></text>
            </staticText>
            <staticText>
                <reportElement x="450" y="0" width="145" height="20" backcolor="#EFEFEF" mode="Opaque"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Situação]]></text>
            </staticText>
            <staticText>
                <reportElement x="595" y="0" width="187" height="20" backcolor="#EFEFEF" mode="Opaque"/>
                <box rightPadding="3"><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Valor Total]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="16">
            <textField>
                <reportElement x="0" y="0" width="80" height="16"/>
                <box><pen lineWidth="0.25" lineColor="#CCCCCC"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{tipoDocumento}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="80" y="0" width="150" height="16"/>
                <box><pen lineWidth="0.25" lineColor="#CCCCCC"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{numero}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="230" y="0" width="80" height="16"/>
                <box><pen lineWidth="0.25" lineColor="#CCCCCC"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{serie}]]></textFieldExpression>
            </textField>
            <textField pattern="dd/MM/yyyy HH:mm" isBlankWhenNull="true">
                <reportElement x="310" y="0" width="140" height="16"/>
                <box><pen lineWidth="0.25" lineColor="#CCCCCC"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{dataEmissao}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="450" y="0" width="145" height="16"/>
                <box><pen lineWidth="0.25" lineColor="#CCCCCC"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{situacao}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00" isBlankWhenNull="true">
                <reportElement x="595" y="0" width="187" height="16"/>
                <box rightPadding="3"><pen lineWidth="0.25" lineColor="#CCCCCC"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{valorTotal}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="20">
            <textField>
                <reportElement x="657" y="0" width="125" height="16"/>
                <textElement textAlignment="Right"><font size="8"/></textElement>
                <textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <!-- <summary> sempre DEPOIS de <pageFooter> (ordem fixa do XSD clássico). -->
    <summary>
        <band height="24">
            <line><reportElement x="0" y="0" width="782" height="1"/></line>
            <textField>
                <reportElement x="0" y="4" width="595" height="16"/>
                <textElement textAlignment="Right"><font size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["TOTAL (" + $V{REPORT_COUNT} + " documento(s))"]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00" isBlankWhenNull="true">
                <reportElement x="595" y="4" width="187" height="16"/>
                <box rightPadding="3"/>
                <textElement textAlignment="Right"><font size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$V{V_TOTAL_VALOR}]]></textFieldExpression>
            </textField>
        </band>
    </summary>

</jasperReport>
