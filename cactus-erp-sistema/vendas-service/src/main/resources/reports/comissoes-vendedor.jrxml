<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="comissoes-vendedor" pageWidth="595" pageHeight="842" columnWidth="535"
              leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20"
              uuid="d3e4f5a6-7b8c-4d9e-0f1a-2b3c4d5e6f70">

    <parameter name="P_TITULO" class="java.lang.String">
        <defaultValueExpression><![CDATA["Comissões por Vendedor"]]></defaultValueExpression>
    </parameter>
    <parameter name="P_PERIODO" class="java.lang.String"/>
    <parameter name="P_DATA_GERACAO" class="java.lang.String"/>

    <field name="vendedorId" class="java.lang.Long"/>
    <field name="valorComissaoTotal" class="java.math.BigDecimal"/>
    <field name="quantidadeVendas" class="java.lang.Long"/>

    <variable name="V_TOTAL_GERAL" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{valorComissaoTotal}]]></variableExpression>
    </variable>

    <title>
        <band height="80">
            <staticText>
                <reportElement x="0" y="0" width="535" height="24"/>
                <textElement><font size="16" isBold="true"/></textElement>
                <text><![CDATA[Cactus ERP]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="26" width="535" height="18"/>
                <textElement><font size="12" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{P_TITULO}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="46" width="267" height="14"/>
                <textElement><font size="9"/></textElement>
                <textFieldExpression><![CDATA["Período (data de lançamento): " + $P{P_PERIODO}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="267" y="46" width="268" height="14"/>
                <textElement textAlignment="Right"><font size="9"/></textElement>
                <textFieldExpression><![CDATA["Gerado em: " + $P{P_DATA_GERACAO}]]></textFieldExpression>
            </textField>
            <line><reportElement x="0" y="66" width="535" height="1"/></line>
        </band>
    </title>

    <columnHeader>
        <band height="20">
            <staticText>
                <reportElement x="0" y="0" width="150" height="20" backcolor="#EFEFEF" mode="Opaque"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Vendedor]]></text>
            </staticText>
            <staticText>
                <reportElement x="150" y="0" width="180" height="20" backcolor="#EFEFEF" mode="Opaque"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Quantidade de Vendas]]></text>
            </staticText>
            <staticText>
                <reportElement x="330" y="0" width="205" height="20" backcolor="#EFEFEF" mode="Opaque"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Comissão Total]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="16">
            <textField>
                <reportElement x="0" y="0" width="150" height="16"/>
                <box><pen lineWidth="0.25" lineColor="#CCCCCC"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="9"/></textElement>
                <textFieldExpression><![CDATA["#" + $F{vendedorId}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="150" y="0" width="180" height="16"/>
                <box><pen lineWidth="0.25" lineColor="#CCCCCC"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{quantidadeVendas}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="330" y="0" width="205" height="16"/>
                <box><pen lineWidth="0.25" lineColor="#CCCCCC"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{valorComissaoTotal}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="20">
            <textField>
                <reportElement x="410" y="0" width="125" height="16"/>
                <textElement textAlignment="Right"><font size="8"/></textElement>
                <textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <!-- <summary> precisa vir DEPOIS de <pageFooter> na ordem do XSD clássico do
         JasperReports — ver comentário equivalente em vendas-periodo.jrxml. -->
    <summary>
        <band height="24">
            <line><reportElement x="0" y="0" width="535" height="1"/></line>
            <staticText>
                <reportElement x="150" y="4" width="180" height="16"/>
                <textElement textAlignment="Right"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[TOTAL GERAL]]></text>
            </staticText>
            <textField pattern="#,##0.00">
                <reportElement x="330" y="4" width="205" height="16"/>
                <textElement textAlignment="Right"><font size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$V{V_TOTAL_GERAL}]]></textFieldExpression>
            </textField>
        </band>
    </summary>

</jasperReport>
