<?xml version="1.0" encoding="UTF-8"?>
<!--
  Template escrito à mão como XML puro (ver ANÁLISE: MÓDULO DE RELATÓRIOS no CLAUDE.md
  raiz — formato clássico do JasperReports 6.x, compatível com Jaspersoft Studio).
  Campos ($F{...}) = componentes do record ComprasFornecedorIndicadorResponse,
  convertidos pra Map<String,Object> por ReportEngine. fornecedorNome já vem resolvido
  pelo IndicadoresService — pode vir null pra um id "órfão", mesmo fallback "#id" já
  usado nos outros templates do BI.
  Retrato: só 4 colunas, cabe confortavelmente sem precisar de paisagem.
-->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="compras-fornecedor" pageWidth="595" pageHeight="842" columnWidth="535"
              leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20" whenNoDataType="AllSectionsNoDetail"
              uuid="f7a8b9c0-5d6e-4f10-2b3c-4d5e6f718293">

    <parameter name="P_TITULO" class="java.lang.String">
        <defaultValueExpression><![CDATA["Resumo de Compras por Fornecedor"]]></defaultValueExpression>
    </parameter>
    <parameter name="P_ANO_MES" class="java.lang.String"/>
    <parameter name="P_DATA_GERACAO" class="java.lang.String"/>

    <field name="anoMes" class="java.lang.String"/>
    <field name="fornecedorId" class="java.lang.Long"/>
    <field name="fornecedorNome" class="java.lang.String"/>
    <field name="quantidadePedidos" class="java.lang.Integer"/>
    <field name="valorTotalComprado" class="java.math.BigDecimal"/>

    <variable name="V_TOTAL_PEDIDOS" class="java.lang.Integer" calculation="Sum">
        <variableExpression><![CDATA[$F{quantidadePedidos}]]></variableExpression>
        <initialValueExpression><![CDATA[0]]></initialValueExpression>
    </variable>
    <variable name="V_TOTAL_VALOR" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{valorTotalComprado}]]></variableExpression>
        <initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression>
    </variable>

    <title>
        <band height="80">
            <staticText>
                <reportElement x="0" y="0" width="535" height="24"/>
                <textElement><font size="16" isBold="true"/></textElement>
                <text><![CDATA[Cactus ERP]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="26" width="535" height="18"/>
                <textElement><font size="12" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{P_TITULO}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="46" width="380" height="14"/>
                <textElement><font size="9"/></textElement>
                <textFieldExpression><![CDATA["Período: " + $P{P_ANO_MES}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="380" y="46" width="155" height="14"/>
                <textElement textAlignment="Right"><font size="9"/></textElement>
                <textFieldExpression><![CDATA["Gerado em: " + $P{P_DATA_GERACAO}]]></textFieldExpression>
            </textField>
            <line><reportElement x="0" y="66" width="535" height="1"/></line>
        </band>
    </title>

    <columnHeader>
        <band height="20">
            <staticText>
                <reportElement x="0" y="0" width="255" height="20" backcolor="#EFEFEF" mode="Opaque"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Fornecedor]]></text>
            </staticText>
            <staticText>
                <reportElement x="255" y="0" width="90" height="20" backcolor="#EFEFEF" mode="Opaque"/>
                <box rightPadding="3"><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Pedidos]]></text>
            </staticText>
            <staticText>
                <reportElement x="345" y="0" width="190" height="20" backcolor="#EFEFEF" mode="Opaque"/>
                <box rightPadding="3"><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Valor Total Comprado]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="16">
            <textField textAdjust="ScaleFont">
                <reportElement x="0" y="0" width="255" height="16"/>
                <box leftPadding="3"><pen lineWidth="0.25" lineColor="#CCCCCC"/></box>
                <textElement verticalAlignment="Middle"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{fornecedorNome} != null ? $F{fornecedorNome} : ("#" + $F{fornecedorId})]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="255" y="0" width="90" height="16"/>
                <box rightPadding="3"><pen lineWidth="0.25" lineColor="#CCCCCC"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{quantidadePedidos}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="345" y="0" width="190" height="16"/>
                <box rightPadding="3"><pen lineWidth="0.25" lineColor="#CCCCCC"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{valorTotalComprado}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="20">
            <textField>
                <reportElement x="410" y="0" width="125" height="16"/>
                <textElement textAlignment="Right"><font size="8"/></textElement>
                <textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <!-- <summary> sempre DEPOIS de <pageFooter> (ordem fixa do XSD clássico). -->
    <summary>
        <band height="24">
            <line><reportElement x="0" y="0" width="535" height="1"/></line>
            <textField>
                <reportElement x="0" y="4" width="255" height="16"/>
                <textElement><font size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["TOTAL (" + $V{REPORT_COUNT} + " fornecedor(es))"]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="255" y="4" width="90" height="16"/>
                <box rightPadding="3"/>
                <textElement textAlignment="Right"><font size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$V{V_TOTAL_PEDIDOS}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00" isBlankWhenNull="true">
                <reportElement x="345" y="4" width="190" height="16"/>
                <box rightPadding="3"/>
                <textElement textAlignment="Right"><font size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$V{V_TOTAL_VALOR}]]></textFieldExpression>
            </textField>
        </band>
    </summary>

</jasperReport>
