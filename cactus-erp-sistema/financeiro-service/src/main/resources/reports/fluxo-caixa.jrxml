<?xml version="1.0" encoding="UTF-8"?>
<!--
  Template escrito à mão como XML puro (ver ANÁLISE: MÓDULO DE RELATÓRIOS no CLAUDE.md
  raiz — formato clássico do JasperReports 6.x, compatível com Jaspersoft Studio).
  Campos ($F{...}) = componentes do record FluxoCaixaPeriodoResponse, convertidos pra
  Map<String,Object> por ReportEngine.
  O período é formatado pelo parâmetro P_PADRAO_PERIODO ("MM/yyyy" quando agrupado por
  mês, "dd/MM/yyyy" por dia) — um pattern fixo no textField não serviria aos dois
  agrupamentos.
-->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="fluxo-caixa" pageWidth="595" pageHeight="842" columnWidth="535"
              leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20" whenNoDataType="AllSectionsNoDetail"
              uuid="3f6a1c2e-8b4d-4e7a-9c1f-2d5e6a7b8c90">

    <parameter name="P_TITULO" class="java.lang.String">
        <defaultValueExpression><![CDATA["Fluxo de Caixa Projetado"]]></defaultValueExpression>
    </parameter>
    <parameter name="P_PERIODO" class="java.lang.String"/>
    <parameter name="P_FILTRO" class="java.lang.String"/>
    <parameter name="P_DATA_GERACAO" class="java.lang.String"/>
    <parameter name="P_PADRAO_PERIODO" class="java.lang.String">
        <defaultValueExpression><![CDATA["MM/yyyy"]]></defaultValueExpression>
    </parameter>

    <!-- Convertido de java.time.LocalDate pra java.util.Date pelo ReportEngine. -->
    <field name="periodo" class="java.util.Date"/>
    <field name="totalEntradas" class="java.math.BigDecimal"/>
    <field name="totalSaidas" class="java.math.BigDecimal"/>
    <field name="saldoPeriodo" class="java.math.BigDecimal"/>
    <field name="saldoAcumulado" class="java.math.BigDecimal"/>

    <variable name="V_TOTAL_ENTRADAS" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{totalEntradas}]]></variableExpression>
        <initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression>
    </variable>
    <variable name="V_TOTAL_SAIDAS" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{totalSaidas}]]></variableExpression>
        <initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression>
    </variable>
    <variable name="V_TOTAL_SALDO" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{saldoPeriodo}]]></variableExpression>
        <initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression>
    </variable>

    <title>
        <band height="80">
            <staticText>
                <reportElement x="0" y="0" width="535" height="24"/>
                <textElement><font size="16" isBold="true"/></textElement>
                <text><![CDATA[Cactus ERP]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="26" width="535" height="18"/>
                <textElement><font size="12" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{P_TITULO}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="46" width="380" height="14"/>
                <textElement><font size="9"/></textElement>
                <textFieldExpression><![CDATA["Vencimento: " + $P{P_PERIODO} + "   |   " + $P{P_FILTRO}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="380" y="46" width="155" height="14"/>
                <textElement textAlignment="Right"><font size="9"/></textElement>
                <textFieldExpression><![CDATA["Gerado em: " + $P{P_DATA_GERACAO}]]></textFieldExpression>
            </textField>
            <line><reportElement x="0" y="66" width="535" height="1"/></line>
        </band>
    </title>

    <columnHeader>
        <band height="20">
            <staticText>
                <reportElement x="0" y="0" width="115" height="20" backcolor="#EFEFEF" mode="Opaque"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Período]]></text>
            </staticText>
            <staticText>
                <reportElement x="115" y="0" width="105" height="20" backcolor="#EFEFEF" mode="Opaque"/>
                <box rightPadding="3"><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Entradas]]></text>
            </staticText>
            <staticText>
                <reportElement x="220" y="0" width="105" height="20" backcolor="#EFEFEF" mode="Opaque"/>
                <box rightPadding="3"><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Saídas]]></text>
            </staticText>
            <staticText>
                <reportElement x="325" y="0" width="105" height="20" backcolor="#EFEFEF" mode="Opaque"/>
                <box rightPadding="3"><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Saldo do Período]]></text>
            </staticText>
            <staticText>
                <reportElement x="430" y="0" width="105" height="20" backcolor="#EFEFEF" mode="Opaque"/>
                <box rightPadding="3"><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Saldo Acumulado]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="16">
            <textField>
                <reportElement x="0" y="0" width="115" height="16"/>
                <box><pen lineWidth="0.25" lineColor="#CCCCCC"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[new java.text.SimpleDateFormat($P{P_PADRAO_PERIODO}).format($F{periodo})]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="115" y="0" width="105" height="16"/>
                <box rightPadding="3"><pen lineWidth="0.25" lineColor="#CCCCCC"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{totalEntradas}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="220" y="0" width="105" height="16"/>
                <box rightPadding="3"><pen lineWidth="0.25" lineColor="#CCCCCC"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{totalSaidas}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00;-#,##0.00">
                <reportElement x="325" y="0" width="105" height="16"/>
                <box rightPadding="3"><pen lineWidth="0.25" lineColor="#CCCCCC"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{saldoPeriodo}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00;-#,##0.00">
                <reportElement x="430" y="0" width="105" height="16"/>
                <box rightPadding="3"><pen lineWidth="0.25" lineColor="#CCCCCC"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{saldoAcumulado}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="20">
            <textField>
                <reportElement x="410" y="0" width="125" height="16"/>
                <textElement textAlignment="Right"><font size="8"/></textElement>
                <textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <!-- <summary> sempre DEPOIS de <pageFooter> (ordem fixa do XSD clássico). -->
    <summary>
        <band height="24">
            <line><reportElement x="0" y="0" width="535" height="1"/></line>
            <staticText>
                <reportElement x="0" y="4" width="115" height="16"/>
                <textElement textAlignment="Center"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[TOTAL]]></text>
            </staticText>
            <textField pattern="#,##0.00" isBlankWhenNull="true">
                <reportElement x="115" y="4" width="105" height="16"/>
                <textElement textAlignment="Right"><font size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$V{V_TOTAL_ENTRADAS}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00" isBlankWhenNull="true">
                <reportElement x="220" y="4" width="105" height="16"/>
                <textElement textAlignment="Right"><font size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$V{V_TOTAL_SAIDAS}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00;-#,##0.00" isBlankWhenNull="true">
                <reportElement x="325" y="4" width="105" height="16"/>
                <textElement textAlignment="Right"><font size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$V{V_TOTAL_SALDO}]]></textFieldExpression>
            </textField>
        </band>
    </summary>

</jasperReport>
