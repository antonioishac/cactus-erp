            </staticText>
            <staticText>
                <reportElement x="411" y="0" width="70" height="20" backcolor="#EFEFEF" mode="Opaque"/>
                <box rightPadding="3"><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                <text><![CDATA[Original]]></text>
            </staticText>
            <staticText>
                <reportElement x="481" y="0" width="65" height="20" backcolor="#EFEFEF" mode="Opaque"/>
