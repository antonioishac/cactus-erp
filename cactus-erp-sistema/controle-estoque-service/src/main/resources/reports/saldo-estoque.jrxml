<?xml version="1.0" encoding="UTF-8"?>
<!--
  Template escrito à mão como XML puro (ver ANÁLISE: MÓDULO DE RELATÓRIOS no CLAUDE.md
  raiz — formato clássico do JasperReports 6.x, compatível com Jaspersoft Studio).
  Campos ($F{...}) = componentes do record SaldoEstoqueResponse, convertidos pra
  Map<String,Object> por ReportEngine. depositoNome já vem resolvido (join local dentro
  do próprio controle-estoque-service, não cross-serviço) — produtoId fica só como "#id"
  mesmo (sem nome: produto vive no cadastro-base-service, sem lookup cross-serviço aqui,
  mesma limitação já registrada em outros relatórios do monorepo).
  Paisagem: 7 colunas não cabem em retrato com fonte legível.
-->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="saldo-estoque" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="782"
              leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20" whenNoDataType="AllSectionsNoDetail"
              uuid="a1b2c3d4-6e7f-4809-9a1b-2c3d4e5f6071">

    <parameter name="P_TITULO" class="java.lang.String">
        <defaultValueExpression><![CDATA["Saldo de Estoque por Depósito"]]></defaultValueExpression>
    </parameter>
    <parameter name="P_FILTRO" class="java.lang.String"/>
    <parameter name="P_DATA_GERACAO" class="java.lang.String"/>

    <field name="produtoId" class="java.lang.Long"/>
    <field name="depositoId" class="java.lang.Long"/>
    <field name="depositoNome" class="java.lang.String"/>
    <field name="quantidade" class="java.math.BigDecimal"/>
    <field name="quantidadeReservada" class="java.math.BigDecimal"/>
    <field name="quantidadeDisponivel" class="java.math.BigDecimal"/>
    <field name="custoMedioPonderado" class="java.math.BigDecimal"/>
    <!-- Convertido de java.time.Instant pra java.util.Date pelo ReportEngine. -->
    <field name="dataUltimaMovimentacao" class="java.util.Date"/>

    <variable name="V_TOTAL_QTD" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{quantidade}]]></variableExpression>
        <initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression>
    </variable>
    <variable name="V_TOTAL_RESERVADA" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{quantidadeReservada}]]></variableExpression>
        <initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression>
    </variable>
    <variable name="V_TOTAL_DISPONIVEL" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{quantidadeDisponivel}]]></variableExpression>
        <initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression>
    </variable>

    <title>
        <band height="80">
            <staticText>
                <reportElement x="0" y="0" width="782" height="24"/>
                <textElement><font size="16" isBold="true"/></textElement>
                <text><![CDATA[Cactus ERP]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="26" width="782" height="18"/>
                <textElement><font size="12" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{P_TITULO}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="46" width="550" height="14"/>
                <textElement><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$P{P_FILTRO}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="550" y="46" width="232" height="14"/>
                <textElement textAlignment="Right"><font size="9"/></textElement>
                <textFieldExpression><![CDATA["Gerado em: " + $P{P_DATA_GERACAO}]]></textFieldExpression>
            </textField>
            <line><reportElement x="0" y="66" width="782" height="1"/></line>
        </band>
    </title>

    <columnHeader>
        <band height="20">
            <staticText>
                <reportElement x="0" y="0" width="150" height="20" backcolor="#EFEFEF" mode="Opaque"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Depósito]]></text>
            </staticText>
            <staticText>
                <reportElement x="150" y="0" width="90" height="20" backcolor="#EFEFEF" mode="Opaque"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Produto]]></text>
            </staticText>
            <staticText>
                <reportElement x="240" y="0" width="100" height="20" backcolor="#EFEFEF" mode="Opaque"/>
                <box rightPadding="3"><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Quantidade]]></text>
            </staticText>
            <staticText>
                <reportElement x="340" y="0" width="100" height="20" backcolor="#EFEFEF" mode="Opaque"/>
                <box rightPadding="3"><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Reservada]]></text>
            </staticText>
            <staticText>
                <reportElement x="440" y="0" width="100" height="20" backcolor="#EFEFEF" mode="Opaque"/>
                <box rightPadding="3"><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Disponível]]></text>
            </staticText>
            <staticText>
                <reportElement x="540" y="0" width="100" height="20" backcolor="#EFEFEF" mode="Opaque"/>
                <box rightPadding="3"><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Custo Médio]]></text>
            </staticText>
            <staticText>
                <reportElement x="640" y="0" width="142" height="20" backcolor="#EFEFEF" mode="Opaque"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Última Movimentação]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="16">
            <textField textAdjust="ScaleFont">
                <reportElement x="0" y="0" width="150" height="16"/>
                <box leftPadding="3"><pen lineWidth="0.25" lineColor="#CCCCCC"/></box>
                <textElement verticalAlignment="Middle"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{depositoNome} != null ? $F{depositoNome} : ("#" + $F{depositoId})]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="150" y="0" width="90" height="16"/>
                <box><pen lineWidth="0.25" lineColor="#CCCCCC"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="9"/></textElement>
                <textFieldExpression><![CDATA["#" + $F{produtoId}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="240" y="0" width="100" height="16"/>
                <box rightPadding="3"><pen lineWidth="0.25" lineColor="#CCCCCC"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{quantidade}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="340" y="0" width="100" height="16"/>
                <box rightPadding="3"><pen lineWidth="0.25" lineColor="#CCCCCC"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{quantidadeReservada}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="440" y="0" width="100" height="16"/>
                <box rightPadding="3"><pen lineWidth="0.25" lineColor="#CCCCCC"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{quantidadeDisponivel}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="540" y="0" width="100" height="16"/>
                <box rightPadding="3"><pen lineWidth="0.25" lineColor="#CCCCCC"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{custoMedioPonderado}]]></textFieldExpression>
            </textField>
            <textField pattern="dd/MM/yyyy HH:mm" isBlankWhenNull="true">
                <reportElement x="640" y="0" width="142" height="16"/>
                <box><pen lineWidth="0.25" lineColor="#CCCCCC"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{dataUltimaMovimentacao}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="20">
            <textField>
                <reportElement x="657" y="0" width="125" height="16"/>
                <textElement textAlignment="Right"><font size="8"/></textElement>
                <textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <!-- <summary> sempre DEPOIS de <pageFooter> (ordem fixa do XSD clássico). -->
    <summary>
        <band height="24">
            <line><reportElement x="0" y="0" width="782" height="1"/></line>
            <textField>
                <reportElement x="0" y="4" width="240" height="16"/>
                <textElement><font size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["TOTAL (" + $V{REPORT_COUNT} + " registro(s))"]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00" isBlankWhenNull="true">
                <reportElement x="240" y="4" width="100" height="16"/>
                <box rightPadding="3"/>
                <textElement textAlignment="Right"><font size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$V{V_TOTAL_QTD}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00" isBlankWhenNull="true">
                <reportElement x="340" y="4" width="100" height="16"/>
                <box rightPadding="3"/>
                <textElement textAlignment="Right"><font size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$V{V_TOTAL_RESERVADA}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00" isBlankWhenNull="true">
                <reportElement x="440" y="4" width="100" height="16"/>
                <box rightPadding="3"/>
                <textElement textAlignment="Right"><font size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$V{V_TOTAL_DISPONIVEL}]]></textFieldExpression>
            </textField>
        </band>
    </summary>

</jasperReport>
