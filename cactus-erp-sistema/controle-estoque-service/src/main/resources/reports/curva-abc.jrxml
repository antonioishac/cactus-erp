<?xml version="1.0" encoding="UTF-8"?>
<!--
  Template escrito à mão como XML puro (sem iReport/Jaspersoft Studio disponível neste
  ambiente — ver ANÁLISE: MÓDULO DE RELATÓRIOS no CLAUDE.md raiz). .jrxml é formato
  aberto: continua editável depois numa ferramenta visual se o usuário instalar uma.

  Campos ($F{...}) correspondem 1:1 aos componentes do record
  br.com.cactusdigital.erp.estoque.dto.CurvaAbcItemResponse — java.beans.Introspector
  reconhece accessors de record como propriedade desde o JDK 16, então o JasperReports
  resolve $F{produtoId} contra record.produtoId() normalmente, sem getters explícitos.
-->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="curva-abc" pageWidth="595" pageHeight="842" columnWidth="535"
              leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20" whenNoDataType="AllSectionsNoDetail"
              uuid="a4f1c1b0-6b2a-4b9a-9d1a-1f2c3d4e5f60">

    <parameter name="P_TITULO" class="java.lang.String">
        <defaultValueExpression><![CDATA["Curva ABC — Classificação por Valor Movimentado"]]></defaultValueExpression>
    </parameter>
    <parameter name="P_PERIODO" class="java.lang.String"/>
    <parameter name="P_DEPOSITO" class="java.lang.String"/>
    <parameter name="P_DATA_GERACAO" class="java.lang.String"/>

    <field name="produtoId" class="java.lang.Long"/>
    <field name="valorMovimentado" class="java.math.BigDecimal"/>
    <field name="percentualParticipacao" class="java.math.BigDecimal"/>
    <field name="percentualAcumulado" class="java.math.BigDecimal"/>
    <field name="classificacao" class="java.lang.String"/>

    <title>
        <band height="80">
            <staticText>
                <reportElement x="0" y="0" width="535" height="24"/>
                <textElement>
                    <font size="16" isBold="true"/>
                </textElement>
                <text><![CDATA[Cactus ERP]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="26" width="535" height="18"/>
                <textElement>
                    <font size="12" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{P_TITULO}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="46" width="380" height="14"/>
                <textElement>
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA["Período: " + $P{P_PERIODO} + "   |   Depósito: " + $P{P_DEPOSITO}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="380" y="46" width="155" height="14">
                    <printWhenExpression><![CDATA[Boolean.TRUE]]></printWhenExpression>
                </reportElement>
                <textElement textAlignment="Right">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA["Gerado em: " + $P{P_DATA_GERACAO}]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="0" y="66" width="535" height="1"/>
            </line>
        </band>
    </title>

    <columnHeader>
        <band height="20">
            <staticText>
                <reportElement x="0" y="0" width="80" height="20" backcolor="#EFEFEF" mode="Opaque"/>
                <box>
                    <pen lineWidth="0.5"/>
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Produto]]></text>
            </staticText>
            <staticText>
                <reportElement x="80" y="0" width="130" height="20" backcolor="#EFEFEF" mode="Opaque"/>
                <box rightPadding="3">
                    <pen lineWidth="0.5"/>
                </box>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Valor Movimentado]]></text>
            </staticText>
            <staticText>
                <reportElement x="210" y="0" width="100" height="20" backcolor="#EFEFEF" mode="Opaque"/>
                <box rightPadding="3">
                    <pen lineWidth="0.5"/>
                </box>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[% Participação]]></text>
            </staticText>
            <staticText>
                <reportElement x="310" y="0" width="100" height="20" backcolor="#EFEFEF" mode="Opaque"/>
                <box rightPadding="3">
                    <pen lineWidth="0.5"/>
                </box>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[% Acumulado]]></text>
            </staticText>
            <staticText>
                <reportElement x="410" y="0" width="125" height="20" backcolor="#EFEFEF" mode="Opaque"/>
                <box>
                    <pen lineWidth="0.5"/>
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Classe]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="16">
            <textField>
                <reportElement x="0" y="0" width="80" height="16"/>
                <box>
                    <pen lineWidth="0.25" lineColor="#CCCCCC"/>
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA["#" + $F{produtoId}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="80" y="0" width="130" height="16"/>
                <box rightPadding="3">
                    <pen lineWidth="0.25" lineColor="#CCCCCC"/>
                </box>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{valorMovimentado}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00'%'">
                <reportElement x="210" y="0" width="100" height="16"/>
                <box rightPadding="3">
                    <pen lineWidth="0.25" lineColor="#CCCCCC"/>
                </box>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{percentualParticipacao}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00'%'">
                <reportElement x="310" y="0" width="100" height="16"/>
                <box rightPadding="3">
                    <pen lineWidth="0.25" lineColor="#CCCCCC"/>
                </box>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{percentualAcumulado}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="410" y="0" width="125" height="16"/>
                <box>
                    <pen lineWidth="0.25" lineColor="#CCCCCC"/>
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{classificacao}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="20">
            <textField>
                <reportElement x="410" y="0" width="125" height="16"/>
                <textElement textAlignment="Right">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

</jasperReport>
