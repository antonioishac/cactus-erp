<?xml version="1.0" encoding="UTF-8"?>
<!--
  Template escrito à mão como XML puro (ver ANÁLISE: MÓDULO DE RELATÓRIOS no CLAUDE.md
  raiz — formato clássico do JasperReports 6.x, compatível com Jaspersoft Studio).
  Campos ($F{...}) = um subconjunto dos componentes de OsAberturaResponse (o record tem
  mais campos — equipamentos/itens/evolucoes entre eles, List<> aninhadas — que não
  entram aqui de propósito, mesmo critério de clientes-cadastro.jrxml no
  cadastro-base-service). osStatusNome já vem resolvido (join local dentro do próprio
  os-service, não cross-serviço); clienteId fica só como "#id" (sem lookup cross-serviço,
  mesma limitação já registrada nos outros relatórios do monorepo).
  Paisagem: 8 colunas não cabem em retrato com fonte legível.
-->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="os-periodo" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="782"
              leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20" whenNoDataType="AllSectionsNoDetail"
              uuid="a7b8c9d0-c3d4-4e6f-e07a-829304152637">

    <parameter name="P_TITULO" class="java.lang.String">
        <defaultValueExpression><![CDATA["Ordens de Serviço por Período"]]></defaultValueExpression>
    </parameter>
    <parameter name="P_PERIODO" class="java.lang.String"/>
    <parameter name="P_FILTRO" class="java.lang.String"/>
    <parameter name="P_DATA_GERACAO" class="java.lang.String"/>

    <field name="numero" class="java.lang.String"/>
    <field name="osStatusNome" class="java.lang.String"/>
    <!-- Convertidos de java.time.LocalDate pra java.util.Date pelo ReportEngine. -->
    <field name="dataInicio" class="java.util.Date"/>
    <field name="dataPrevisao" class="java.util.Date"/>
    <field name="dataFim" class="java.util.Date"/>
    <field name="clienteId" class="java.lang.Long"/>
    <field name="orcamentoAprovado" class="java.lang.Boolean"/>
    <field name="valorTotal" class="java.math.BigDecimal"/>

    <variable name="V_TOTAL_VALOR" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{valorTotal}]]></variableExpression>
        <initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression>
    </variable>

    <title>
        <band height="80">
            <staticText>
                <reportElement x="0" y="0" width="782" height="24"/>
                <textElement><font size="16" isBold="true"/></textElement>
                <text><![CDATA[Cactus ERP]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="26" width="782" height="18"/>
                <textElement><font size="12" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{P_TITULO}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="46" width="550" height="14"/>
                <textElement><font size="9"/></textElement>
                <textFieldExpression><![CDATA["Período: " + $P{P_PERIODO} + "   |   " + $P{P_FILTRO}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="550" y="46" width="232" height="14"/>
                <textElement textAlignment="Right"><font size="9"/></textElement>
                <textFieldExpression><![CDATA["Gerado em: " + $P{P_DATA_GERACAO}]]></textFieldExpression>
            </textField>
            <line><reportElement x="0" y="66" width="782" height="1"/></line>
        </band>
    </title>

    <columnHeader>
        <band height="20">
            <staticText>
                <reportElement x="0" y="0" width="80" height="20" backcolor="#EFEFEF" mode="Opaque"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Número]]></text>
            </staticText>
            <staticText>
                <reportElement x="80" y="0" width="130" height="20" backcolor="#EFEFEF" mode="Opaque"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Status]]></text>
            </staticText>
            <staticText>
                <reportElement x="210" y="0" width="75" height="20" backcolor="#EFEFEF" mode="Opaque"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Início]]></text>
            </staticText>
            <staticText>
                <reportElement x="285" y="0" width="75" height="20" backcolor="#EFEFEF" mode="Opaque"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Previsão]]></text>
            </staticText>
            <staticText>
                <reportElement x="360" y="0" width="75" height="20" backcolor="#EFEFEF" mode="Opaque"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Fim]]></text>
            </staticText>
            <staticText>
                <reportElement x="435" y="0" width="70" height="20" backcolor="#EFEFEF" mode="Opaque"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Cliente]]></text>
            </staticText>
            <staticText>
                <reportElement x="505" y="0" width="90" height="20" backcolor="#EFEFEF" mode="Opaque"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Orç. Aprovado]]></text>
            </staticText>
            <staticText>
                <reportElement x="595" y="0" width="187" height="20" backcolor="#EFEFEF" mode="Opaque"/>
                <box rightPadding="3"><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Valor Total]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="16">
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="0" width="80" height="16"/>
                <box><pen lineWidth="0.25" lineColor="#CCCCCC"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{numero}]]></textFieldExpression>
            </textField>
            <textField textAdjust="ScaleFont">
                <reportElement x="80" y="0" width="130" height="16"/>
                <box leftPadding="3"><pen lineWidth="0.25" lineColor="#CCCCCC"/></box>
                <textElement verticalAlignment="Middle"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{osStatusNome}]]></textFieldExpression>
            </textField>
            <textField pattern="dd/MM/yyyy" isBlankWhenNull="true">
                <reportElement x="210" y="0" width="75" height="16"/>
                <box><pen lineWidth="0.25" lineColor="#CCCCCC"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{dataInicio}]]></textFieldExpression>
            </textField>
            <textField pattern="dd/MM/yyyy" isBlankWhenNull="true">
                <reportElement x="285" y="0" width="75" height="16"/>
                <box><pen lineWidth="0.25" lineColor="#CCCCCC"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{dataPrevisao}]]></textFieldExpression>
            </textField>
            <textField pattern="dd/MM/yyyy" isBlankWhenNull="true">
                <reportElement x="360" y="0" width="75" height="16"/>
                <box><pen lineWidth="0.25" lineColor="#CCCCCC"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{dataFim}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="435" y="0" width="70" height="16"/>
                <box><pen lineWidth="0.25" lineColor="#CCCCCC"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="9"/></textElement>
                <textFieldExpression><![CDATA["#" + $F{clienteId}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="505" y="0" width="90" height="16"/>
                <box><pen lineWidth="0.25" lineColor="#CCCCCC"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{orcamentoAprovado} ? "Sim" : "Não"]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00" isBlankWhenNull="true">
                <reportElement x="595" y="0" width="187" height="16"/>
                <box rightPadding="3"><pen lineWidth="0.25" lineColor="#CCCCCC"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{valorTotal}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="20">
            <textField>
                <reportElement x="657" y="0" width="125" height="16"/>
                <textElement textAlignment="Right"><font size="8"/></textElement>
                <textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <!-- <summary> sempre DEPOIS de <pageFooter> (ordem fixa do XSD clássico). -->
    <summary>
        <band height="24">
            <line><reportElement x="0" y="0" width="782" height="1"/></line>
            <textField>
                <reportElement x="0" y="4" width="595" height="16"/>
                <textElement textAlignment="Right"><font size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["TOTAL (" + $V{REPORT_COUNT} + " OS)"]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00" isBlankWhenNull="true">
                <reportElement x="595" y="4" width="187" height="16"/>
                <box rightPadding="3"/>
                <textElement textAlignment="Right"><font size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$V{V_TOTAL_VALOR}]]></textFieldExpression>
            </textField>
        </band>
    </summary>

</jasperReport>
