<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx/24.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="br.com.cactuserp.pdv.controllers.AberturaMesaController"
      fx:id="root"
      styleClass="sm-abertura-root"
      prefWidth="460" prefHeight="320" spacing="0">

    <!-- Header -->
    <HBox styleClass="sm-abertura-header" alignment="CENTER_LEFT" spacing="10">
        <padding>
            <Insets top="14" right="20" bottom="14" left="20"/>
        </padding>
        <FontIcon iconLiteral="mdi2t-table-furniture" iconSize="22" iconColor="white"/>
        <Label fx:id="lblTitulo" text="Abrir Mesa" styleClass="sm-abertura-titulo"/>
    </HBox>

    <!-- Corpo -->
    <VBox spacing="14" styleClass="sm-abertura-corpo" VBox.vgrow="ALWAYS">
        <padding>
            <Insets top="20" right="24" bottom="20" left="24"/>
        </padding>

        <VBox spacing="4">
            <Label fx:id="lblMesaInfo" text="—" styleClass="sm-abertura-mesa-info"/>
        </VBox>

        <VBox spacing="4">
            <Label text="NOME DO CLIENTE (OPCIONAL)" styleClass="sm-abertura-label"/>
            <TextField fx:id="tfNomeCliente" promptText="Ex: João da Silva"
                       styleClass="sm-abertura-input"/>
            <Label text="Use pra identificar quem está na mesa. Pode deixar vazio."
                   styleClass="sm-abertura-dica"/>
        </VBox>

        <Region VBox.vgrow="ALWAYS"/>

        <HBox spacing="10" alignment="CENTER_RIGHT">
            <Button fx:id="btnCancelar" text="CANCELAR (ESC)"
                    styleClass="sm-btn-secundario" onAction="#aoCancelar"/>
            <Button fx:id="btnAbrir" text="ABRIR MESA (F2)"
                    styleClass="sm-btn-primario" onAction="#aoAbrir" defaultButton="true"/>
        </HBox>
    </VBox>
</VBox>
