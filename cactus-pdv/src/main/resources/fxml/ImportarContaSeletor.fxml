<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx/24.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="br.com.cactuserp.pdv.controllers.ImportarContaSeletorController"
      fx:id="root"
      styleClass="sm-abertura-root"
      prefWidth="560" prefHeight="320" spacing="0">

    <!-- Header -->
    <HBox styleClass="sm-abertura-header" alignment="CENTER_LEFT" spacing="10">
        <padding>
            <Insets top="14" right="20" bottom="14" left="20"/>
        </padding>
        <FontIcon iconLiteral="mdi2t-tray-arrow-down" iconSize="22" iconColor="white"/>
        <Label text="Importar conta pro cupom" styleClass="sm-abertura-titulo"/>
    </HBox>

    <!-- Corpo -->
    <VBox spacing="14" styleClass="sm-abertura-corpo" VBox.vgrow="ALWAYS">
        <padding>
            <Insets top="24" right="24" bottom="20" left="24"/>
        </padding>

        <Label text="Escolha de onde importar os itens:"
               styleClass="ic-seletor-instrucao"/>

        <HBox spacing="14" alignment="CENTER">

            <!-- BOTÃO MESA -->
            <Button fx:id="btnMesa" onAction="#aoEscolherMesa"
                    styleClass="ic-botao-opcao,ic-botao-mesa"
                    HBox.hgrow="ALWAYS" maxWidth="Infinity">
                <graphic>
                    <VBox alignment="CENTER" spacing="8">
                        <FontIcon iconLiteral="mdi2s-silverware-fork-knife"
                                  iconSize="42" iconColor="#2969c9"/>
                        <Label text="MESA" styleClass="ic-botao-label-mesa"/>
                        <Label text="F2" styleClass="ic-botao-atalho"/>
                    </VBox>
                </graphic>
            </Button>

            <!-- BOTÃO COMANDA -->
            <Button fx:id="btnComanda" onAction="#aoEscolherComanda"
                    styleClass="ic-botao-opcao,ic-botao-comanda"
                    HBox.hgrow="ALWAYS" maxWidth="Infinity">
                <graphic>
                    <VBox alignment="CENTER" spacing="8">
                        <FontIcon iconLiteral="mdi2r-receipt"
                                  iconSize="42" iconColor="#c9901e"/>
                        <Label text="COMANDA" styleClass="ic-botao-label-comanda"/>
                        <Label text="F3" styleClass="ic-botao-atalho"/>
                    </VBox>
                </graphic>
            </Button>
        </HBox>

        <Region VBox.vgrow="ALWAYS"/>

        <Label text="F2 ou F3 para escolher · ESC para cancelar"
               styleClass="ic-seletor-rodape"/>
    </VBox>
</VBox>
