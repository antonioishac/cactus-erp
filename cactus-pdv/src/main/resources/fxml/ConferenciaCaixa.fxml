<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<AnchorPane fx:id="root" prefHeight="800.0" prefWidth="1280.0"
            styleClass="cp-root"
            stylesheets="@styles/consulta-produto.css"
            xmlns="http://javafx.com/javafx/24.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="br.com.cactuserp.pdv.controllers.ConferenciaCaixaController">

    <VBox AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
          AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

        <!-- HEADER -->
        <HBox styleClass="cp-header" alignment="CENTER_LEFT" spacing="14">
            <FontIcon iconLiteral="mdi2c-calculator" iconSize="28" iconColor="white"/>
            <VBox spacing="2">
                <Label text="CONFERÊNCIA DE CAIXA" styleClass="cp-header-titulo"/>
                <Label text="Conte o dinheiro físico e confira os comprovantes eletrônicos"
                       styleClass="cp-header-sub"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblOperador" text="" styleClass="cp-header-hint"/>
            <Label text="·" styleClass="cp-header-hint"/>
            <Label text="ESC para voltar" styleClass="cp-header-hint"/>
        </HBox>

        <!-- CORPO -->
        <ScrollPane fitToWidth="true" styleClass="cp-detalhe-scroll" VBox.vgrow="ALWAYS">
            <VBox spacing="14">
                <padding>
                    <Insets top="20" right="40" bottom="20" left="40"/>
                </padding>

                <!-- Info do movimento -->
                <VBox styleClass="cc2-card-info" spacing="2">
                    <padding>
                        <Insets top="12" right="16" bottom="12" left="16"/>
                    </padding>
                    <Label text="MOVIMENTO ATUAL" styleClass="cc2-info-label"/>
                    <Label fx:id="lblInfoMovimento" text="—" styleClass="cc2-info-titulo"/>
                    <Label fx:id="lblInfoGerente" text="—" styleClass="cc2-info-sub"/>
                </VBox>

                <!-- CARD GRANDE DA CONFERÊNCIA -->
                <VBox styleClass="cc2-card-conferencia" spacing="0">

                    <!-- Header preto da "tabela" -->
                    <HBox styleClass="cc2-tabela-header" alignment="CENTER_LEFT">
                        <padding>
                            <Insets top="12" right="18" bottom="12" left="18"/>
                        </padding>
                        <Label text="FORMA DE PAGAMENTO" styleClass="cc2-header-label"
                               prefWidth="340" HBox.hgrow="ALWAYS"/>
                        <Label text="ESPERADO" styleClass="cc2-header-label-right" prefWidth="140" maxWidth="140"/>
                        <Label text="CONTADO" styleClass="cc2-header-label-right" prefWidth="160" maxWidth="160"/>
                        <Label text="DIVERGÊNCIA" styleClass="cc2-header-label-right" prefWidth="140" maxWidth="140"/>
                    </HBox>

                    <!-- Linhas dinâmicas (geradas pelo controller) -->
                    <VBox fx:id="containerFormas" spacing="0"/>

                    <!-- Total -->
                    <HBox styleClass="cc2-total-linha" alignment="CENTER_LEFT">
                        <padding>
                            <Insets top="14" right="18" bottom="14" left="18"/>
                        </padding>
                        <Label text="TOTAL" styleClass="cc2-total-label"
                               prefWidth="340" HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblTotalEsperado" text="R$ 0,00" styleClass="cc2-total-valor"
                               prefWidth="140" maxWidth="140"/>
                        <Label fx:id="lblTotalContado" text="R$ 0,00" styleClass="cc2-total-valor"
                               prefWidth="160" maxWidth="160"/>
                        <Label fx:id="lblTotalDivergencia" text="R$ 0,00" styleClass="cc2-total-valor"
                               prefWidth="140" maxWidth="140"/>
                    </HBox>
                </VBox>

                <!-- Observação -->
                <VBox styleClass="cc2-card-info" spacing="6">
                    <padding>
                        <Insets top="12" right="16" bottom="12" left="16"/>
                    </padding>
                    <Label text="OBSERVAÇÃO (OPCIONAL)" styleClass="cc2-info-label"/>
                    <TextArea fx:id="taObservacao" styleClass="cc2-observacao"
                              promptText="Anote o motivo de eventual divergência..."
                              prefRowCount="2" wrapText="true"/>
                </VBox>

                <!-- Botões -->
                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <Button fx:id="btnRecontar" text="RECONTAR (F3)" styleClass="cc2-btn-secundario"
                            onAction="#aoClicarRecontar"/>
                    <Button fx:id="btnCancelar" text="CANCELAR (ESC)" styleClass="cc2-btn-secundario"
                            onAction="#aoClicarCancelar"/>
                    <Button fx:id="btnConfirmar" text="CONFIRMAR (F2)" styleClass="cc2-btn-confirmar"
                            onAction="#aoClicarConfirmar"/>
                </HBox>
            </VBox>
        </ScrollPane>

        <!-- RODAPÉ -->
        <HBox styleClass="cp-rodape" alignment="CENTER_LEFT" spacing="20">
            <padding>
                <Insets top="10" right="20" bottom="10" left="20"/>
            </padding>
            <Label text="TAB Navegar  ·  ENTER Próximo campo  ·  F2 Confirmar  ·  F3 Recontar  ·  ESC Cancelar"
                   styleClass="cp-rodape-texto"/>
        </HBox>
    </VBox>
</AnchorPane>
