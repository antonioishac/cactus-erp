<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<AnchorPane fx:id="root" prefHeight="800.0" prefWidth="1280.0"
            styleClass="cp-root"
            stylesheets="@styles/salao-mesas.css"
            xmlns="http://javafx.com/javafx/24.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="br.com.cactuserp.pdv.controllers.BuscarContaController">

    <VBox AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
          AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

        <!-- HEADER -->
        <HBox styleClass="cp-header" alignment="CENTER_LEFT" spacing="14">
            <FontIcon fx:id="iconeHeader" iconLiteral="mdi2t-tray-arrow-down"
                      iconSize="28" iconColor="white"/>
            <VBox spacing="2">
                <Label fx:id="lblTitulo" text="Importar pro cupom"
                       styleClass="cp-header-titulo"/>
                <Label fx:id="lblSubtitulo"
                       text="Digite o identificador e veja os itens antes de importar"
                       styleClass="cp-header-sub"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="ESC voltar · F8 importar" styleClass="cp-header-hint"/>
        </HBox>

        <!-- TOOLBAR DE BUSCA -->
        <HBox styleClass="sm-toolbar" alignment="CENTER_LEFT" spacing="12">
            <padding>
                <Insets top="16" right="20" bottom="16" left="20"/>
            </padding>

            <VBox spacing="2">
                <Label fx:id="lblLabelBusca" text="IDENTIFICADOR"
                       styleClass="sm-label-busca"/>
                <TextField fx:id="tfBusca" prefWidth="220"
                           styleClass="sm-input-busca"/>
            </VBox>

            <Button fx:id="btnBuscar" text="BUSCAR (ENTER)"
                    styleClass="sm-btn-secundario" onAction="#aoBuscar"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Label fx:id="lblMensagem" text="" styleClass="sm-mensagem"/>
        </HBox>

        <!-- INFO DA CONTA -->
        <HBox fx:id="boxInfoConta" styleClass="bc-info-conta"
              alignment="CENTER_LEFT" spacing="12" visible="false" managed="false">
            <padding>
                <Insets top="12" right="24" bottom="12" left="24"/>
            </padding>
            <FontIcon fx:id="iconeConta" iconLiteral="mdi2s-silverware-fork-knife"
                      iconSize="22"/>
            <VBox spacing="2">
                <Label fx:id="lblInfoTitulo" text="" styleClass="bc-info-titulo"/>
                <Label fx:id="lblInfoSub" text="" styleClass="bc-info-sub"/>
            </VBox>
        </HBox>

        <!-- LISTA DE ITENS -->
        <VBox styleClass="sm-card-itens" VBox.vgrow="ALWAYS" spacing="0">
            <padding>
                <Insets top="0" right="14" bottom="0" left="14"/>
            </padding>

            <Label fx:id="lblTituloItens" text="" styleClass="bc-titulo-itens"
                   visible="false" managed="false"/>

            <TableView fx:id="tabelaItens" VBox.vgrow="ALWAYS"
                       styleClass="sm-tabela-itens">
                <columns>
                    <TableColumn fx:id="colSeq"   prefWidth="50"  text="SEQ"/>
                    <TableColumn fx:id="colDesc"  prefWidth="400" text="DESCRIÇÃO"/>
                    <TableColumn fx:id="colObs"   prefWidth="220" text="OBSERVAÇÃO"/>
                    <TableColumn fx:id="colQtd"   prefWidth="80"  text="QTD"/>
                    <TableColumn fx:id="colVlrU"  prefWidth="120" text="VLR UNIT"/>
                    <TableColumn fx:id="colTotal" prefWidth="140" text="TOTAL"/>
                </columns>
            </TableView>

            <Label fx:id="lblVazio"
                   text="Digite o identificador acima e ENTER para buscar."
                   styleClass="bc-vazio" visible="true" managed="true"/>
        </VBox>

        <!-- TOTAL + AÇÕES -->
        <HBox styleClass="sm-rodape-acao" alignment="CENTER_LEFT" spacing="14">
            <padding>
                <Insets top="14" right="20" bottom="14" left="20"/>
            </padding>

            <VBox spacing="2">
                <Label text="TOTAL A IMPORTAR" styleClass="sm-label-total"/>
                <Label fx:id="lblTotal" text="R$ 0,00" styleClass="sm-valor-total"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <Button fx:id="btnCancelar" text="CANCELAR (ESC)"
                    styleClass="sm-btn-secundario" onAction="#aoCancelar"/>
            <Button fx:id="btnImportar" text="IMPORTAR PRO CUPOM (F8)"
                    styleClass="sm-btn-primario" onAction="#aoImportar"
                    disable="true"/>
        </HBox>

        <!-- RODAPÉ -->
        <HBox styleClass="cp-rodape" alignment="CENTER_LEFT" spacing="20">
            <padding>
                <Insets top="10" right="20" bottom="10" left="20"/>
            </padding>
            <Label text="ENTER Buscar · F8 Importar · ESC Cancelar"
                   styleClass="cp-rodape-texto"/>
        </HBox>
    </VBox>
</AnchorPane>
