<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
      prefHeight="500.0" prefWidth="950.0" styleClass="fundo"
      stylesheets="@styles/CactusPdv.css"
      xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="br.com.cactuserp.pdv.controllers.IniciarMovimentoController">

    <VBox prefHeight="500.0" prefWidth="950.0" styleClass="painel">
        <HBox.margin>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
        </HBox.margin>

        <HBox prefHeight="33.0" prefWidth="910.0" styleClass="gradient-topo">
            <Label text="Iniciar Movimento de Caixa" textFill="WHITE" />
        </HBox>

        <VBox prefHeight="330.0" prefWidth="910.0" style="-fx-background-color: #F3F4F6;" styleClass="painel-produto">
            <VBox.margin>
                <Insets top="10.0" />
            </VBox.margin>
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>

            <!-- Linha 1: autorização -->
            <Label styleClass="label-produto" text="Autorização (Gerente / Supervisor)">
                <VBox.margin><Insets bottom="5.0" top="5.0" /></VBox.margin>
            </Label>
            <HBox spacing="10.0">
                <VBox.margin><Insets bottom="10.0" /></VBox.margin>
                <VBox HBox.hgrow="ALWAYS">
                    <Label text="Login" />
                    <TextField fx:id="tfLoginGerente" prefHeight="32.0" />
                </VBox>
                <VBox HBox.hgrow="ALWAYS">
                    <Label text="Senha" />
                    <PasswordField fx:id="pfSenhaGerente" prefHeight="32.0" />
                </VBox>
                <VBox>
                    <Label text="&#160;" />
                    <Button fx:id="btnValidar" mnemonicParsing="false" prefHeight="32.0"
                            styleClass="button-verde" text="Validar" />
                </VBox>
            </HBox>
            <Label fx:id="lblGerenteValidado" text="" />

            <!-- Linha 2: operador e caixa -->
            <HBox spacing="10.0">
                <VBox.margin><Insets top="15.0" /></VBox.margin>
                <VBox HBox.hgrow="ALWAYS">
                    <Label styleClass="label-produto" text="Operador" />
                    <ComboBox fx:id="cbOperador" prefHeight="32.0" maxWidth="Infinity" />
                </VBox>
                <VBox HBox.hgrow="ALWAYS">
                    <Label styleClass="label-produto" text="Caixa" />
                    <ComboBox fx:id="cbCaixa" prefHeight="32.0" maxWidth="Infinity" />
                </VBox>
            </HBox>

            <!-- Linha 3: suprimento -->
            <VBox>
                <VBox.margin><Insets top="15.0" /></VBox.margin>
                <Label styleClass="label-produto" text="Suprimento Inicial (Fundo de Caixa)" />
                <TextField fx:id="tfValorInicial" prefHeight="32.0" promptText="0,00" />
            </VBox>

        </VBox>

        <HBox prefHeight="60.0" prefWidth="910.0" style="-fx-alignment: CENTER;">
            <Button fx:id="btnConfirmar" mnemonicParsing="false" styleClass="button-verde" text="[F1] - Confirmar Abertura">
                <HBox.margin><Insets right="10.0" top="10.0" /></HBox.margin>
            </Button>
            <Button fx:id="btnCancelar" mnemonicParsing="false" styleClass="button-vermelho" text="[F10] - Cancelar">
                <HBox.margin><Insets top="10.0" /></HBox.margin>
            </Button>
        </HBox>
    </VBox>
</HBox>