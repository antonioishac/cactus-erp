<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<AnchorPane fx:id="root" prefHeight="800.0" prefWidth="1280.0"
            styleClass="cp-root"
            stylesheets="@styles/salao-mesas.css"
            xmlns="http://javafx.com/javafx/24.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="br.com.cactuserp.pdv.controllers.SalaoMesasController">

    <VBox AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
          AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

        <!-- HEADER -->
        <HBox styleClass="cp-header" alignment="CENTER_LEFT" spacing="14">
            <FontIcon iconLiteral="mdi2s-silverware-fork-knife" iconSize="28" iconColor="white"/>
            <VBox spacing="2">
                <Label text="SALÃO DE MESAS" styleClass="cp-header-titulo"/>
                <Label text="Selecione uma mesa para abrir ou continuar atendimento"
                       styleClass="cp-header-sub"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblOperador" text="" styleClass="cp-header-hint"/>
            <Label text="·" styleClass="cp-header-hint"/>
            <Label text="ESC para voltar" styleClass="cp-header-hint"/>
        </HBox>

        <!-- BARRA DE BUSCA + LEGENDA -->
        <HBox styleClass="sm-toolbar" alignment="CENTER_LEFT" spacing="20">
            <padding>
                <Insets top="12" right="20" bottom="12" left="20"/>
            </padding>

            <VBox spacing="2">
                <Label text="BUSCAR MESA (Nº)" styleClass="sm-label-busca"/>
                <TextField fx:id="tfBusca" promptText="Digite o número e ENTER"
                           styleClass="sm-input-busca" prefWidth="220"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- Legenda -->
            <HBox spacing="14" alignment="CENTER_LEFT">
                <HBox spacing="6" alignment="CENTER_LEFT">
                    <Region styleClass="sm-legenda-livre"/>
                    <Label text="Livre" styleClass="sm-legenda-texto"/>
                </HBox>
                <HBox spacing="6" alignment="CENTER_LEFT">
                    <Region styleClass="sm-legenda-ocupada"/>
                    <Label text="Ocupada" styleClass="sm-legenda-texto"/>
                </HBox>
                <HBox spacing="6" alignment="CENTER_LEFT">
                    <Region styleClass="sm-legenda-atendimento"/>
                    <Label text="Em atendimento" styleClass="sm-legenda-texto"/>
                </HBox>
            </HBox>
        </HBox>

        <!-- CORPO (grid de setores) -->
        <ScrollPane fitToWidth="true" styleClass="cp-detalhe-scroll" VBox.vgrow="ALWAYS">
            <VBox fx:id="containerSetores" spacing="20">
                <padding>
                    <Insets top="18" right="24" bottom="18" left="24"/>
                </padding>
                <!-- Setores adicionados dinamicamente pelo controller -->
            </VBox>
        </ScrollPane>

        <!-- RODAPÉ -->
        <HBox styleClass="cp-rodape" alignment="CENTER_LEFT" spacing="20">
            <padding>
                <Insets top="10" right="20" bottom="10" left="20"/>
            </padding>
            <Label text="↑↓←→ Navegar  ·  ENTER Selecionar mesa  ·  Nº+ENTER Busca rápida  ·  F5 Atualizar  ·  ESC Voltar"
                   styleClass="cp-rodape-texto"/>
        </HBox>
    </VBox>
</AnchorPane>
