<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
      prefHeight="600.0" prefWidth="950.0"
      styleClass="fundo"
      stylesheets="@styles/produtos.css"
      xmlns="http://javafx.com/javafx/24.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="br.com.cactuserp.pdv.controllers.CancelarItemController">

    <VBox fx:id="root" prefHeight="600.0" prefWidth="954.0" styleClass="painel">
        <HBox.margin>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
        </HBox.margin>

        <!-- Topo com gradiente -->
        <HBox prefHeight="33.0" prefWidth="910.0" styleClass="gradient-topo">
            <Label text="Cancelar Item" textFill="WHITE" />
        </HBox>

        <!-- Área principal -->
        <VBox prefHeight="433.0" prefWidth="910.0"
              style="-fx-background-color: #F3F4F6;"
              styleClass="painel-produto">
            <VBox.margin>
                <Insets top="10.0" />
            </VBox.margin>
            <padding>
                <Insets bottom="10.0" />
            </padding>

            <Label styleClass="label-produto" text="Selecione o item para cancelar:">
                <VBox.margin>
                    <Insets bottom="10.0" left="10.0" top="10.0" />
                </VBox.margin>
            </Label>

            <TableView fx:id="tabelaItens" prefHeight="380.0" prefWidth="880.0" styleClass="tabela-pdv">
                <columns>
                    <TableColumn fx:id="colSeq"     prefWidth="80.0"   text="Seq" />
                    <TableColumn fx:id="colProduto" prefWidth="430.0"  text="Produto" />
                    <TableColumn fx:id="colQtde"    prefWidth="100.0"  text="Qtd" />
                    <TableColumn fx:id="colValor"   prefWidth="140.0"  text="Valor" />
                    <TableColumn fx:id="colStatus"  prefWidth="120.0"  text="Status" />
                </columns>
                <VBox.margin>
                    <Insets left="10.0" right="10.0" />
                </VBox.margin>
            </TableView>
        </VBox>

        <!-- Rodapé com botões -->
        <HBox prefHeight="60.0" prefWidth="910.0" style="-fx-alignment: CENTER;">
            <Button fx:id="btnConfirmar" mnemonicParsing="false"
                    styleClass="button-verde"
                    text="[ENTER] - Cancelar Item"
                    onAction="#confirmar">
                <HBox.margin>
                    <Insets right="10.0" top="10.0" />
                </HBox.margin>
            </Button>
            <Button fx:id="btnCancelar" mnemonicParsing="false"
                    styleClass="button-vermelho"
                    text="[ESC] - Voltar"
                    onAction="#voltar">
                <HBox.margin>
                    <Insets top="10.0" />
                </HBox.margin>
            </Button>
        </HBox>
    </VBox>
</HBox>