<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<AnchorPane fx:id="root" prefHeight="800.0" prefWidth="1280.0"
            styleClass="cp-root"
            stylesheets="@styles/salao-mesas.css"
            xmlns="http://javafx.com/javafx/24.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="br.com.cactuserp.pdv.controllers.LancamentoMesaController">

    <VBox AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
          AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

        <!-- HEADER -->
        <HBox styleClass="cp-header" alignment="CENTER_LEFT" spacing="14">
            <FontIcon iconLiteral="mdi2t-table-furniture" iconSize="28" iconColor="white"/>
            <VBox spacing="2">
                <Label fx:id="lblTitulo" text="MESA —" styleClass="cp-header-titulo"/>
                <Label fx:id="lblSubtitulo" text="—" styleClass="cp-header-sub"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblOperador" text="" styleClass="cp-header-hint"/>
            <Label text="·" styleClass="cp-header-hint"/>
            <Label text="ESC voltar ao salão" styleClass="cp-header-hint"/>
        </HBox>

        <!-- BARRA DE LANÇAMENTO -->
        <HBox styleClass="sm-toolbar" alignment="CENTER_LEFT" spacing="12">
            <padding>
                <Insets top="14" right="20" bottom="14" left="20"/>
            </padding>

            <VBox spacing="2">
                <Label text="CÓDIGO / EAN" styleClass="sm-label-busca"/>
                <TextField fx:id="tfCodigo" promptText="Bipa ou digita o código"
                           styleClass="sm-input-busca" prefWidth="280"/>
            </VBox>

            <VBox spacing="2">
                <Label text="QTD" styleClass="sm-label-busca"/>
                <TextField fx:id="tfQuantidade" text="1"
                           styleClass="sm-input-busca" prefWidth="80"/>
            </VBox>

            <VBox spacing="2">
                <Label text="OBSERVAÇÃO (OPCIONAL)" styleClass="sm-label-busca"/>
                <TextField fx:id="tfObservacao"
                           promptText="Ex: sem cebola, bem passada"
                           styleClass="sm-input-busca" prefWidth="280"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <VBox spacing="2">
                <Label text=" " styleClass="sm-label-busca"/>
                <Label fx:id="lblMensagem" text="" styleClass="sm-mensagem"/>
            </VBox>
        </HBox>

        <!-- LISTA DE ITENS -->
        <VBox styleClass="sm-card-itens" VBox.vgrow="ALWAYS" spacing="0">
            <padding>
                <Insets top="0" right="14" bottom="0" left="14"/>
            </padding>
            <TableView fx:id="tabelaItens" VBox.vgrow="ALWAYS"
                       styleClass="sm-tabela-itens">
                <columns>
                    <TableColumn fx:id="colSeq"   prefWidth="50"  text="SEQ"/>
                    <TableColumn fx:id="colDesc"  prefWidth="350" text="DESCRIÇÃO"/>
                    <TableColumn fx:id="colObs"   prefWidth="200" text="OBSERVAÇÃO"/>
                    <TableColumn fx:id="colQtd"   prefWidth="70"  text="QTD"/>
                    <TableColumn fx:id="colVlrU"  prefWidth="100" text="VLR UNIT"/>
                    <TableColumn fx:id="colTotal" prefWidth="120" text="TOTAL"/>
                    <TableColumn fx:id="colHora"  prefWidth="80"  text="HORA"/>
                    <TableColumn fx:id="colOp"    prefWidth="120" text="OPERADOR"/>
                </columns>
            </TableView>
        </VBox>

        <!-- TOTAL + BOTÕES -->
        <HBox styleClass="sm-rodape-acao" alignment="CENTER_LEFT" spacing="14">
            <padding>
                <Insets top="14" right="20" bottom="14" left="20"/>
            </padding>

            <VBox spacing="2">
                <Label text="TOTAL DA MESA" styleClass="sm-label-total"/>
                <Label fx:id="lblTotal" text="R$ 0,00" styleClass="sm-valor-total"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <Button fx:id="btnCancelarItem" text="CANCELAR ITEM (F1)"
                    styleClass="sm-btn-secundario" onAction="#aoCancelarItem"/>
            <Button fx:id="btnVoltar" text="VOLTAR AO SALÃO (ESC)"
                    styleClass="sm-btn-secundario" onAction="#aoVoltar"/>
        </HBox>

        <!-- RODAPÉ -->
        <HBox styleClass="cp-rodape" alignment="CENTER_LEFT" spacing="20">
            <padding>
                <Insets top="10" right="20" bottom="10" left="20"/>
            </padding>
            <Label text="ENTER Lança item  ·  F1 Cancelar item  ·  F3 Editar qtd  ·  F11 Buscar produto  ·  ESC Voltar"
                   styleClass="cp-rodape-texto"/>
        </HBox>
    </VBox>
</AnchorPane>
