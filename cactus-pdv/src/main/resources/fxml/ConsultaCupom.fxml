<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<AnchorPane fx:id="root" prefHeight="800.0" prefWidth="1280.0"
            styleClass="cp-root"
            stylesheets="@styles/consulta-produto.css"
            xmlns="http://javafx.com/javafx/24.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="br.com.cactuserp.pdv.controllers.ConsultaCupomController">

    <VBox AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
          AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

        <!-- HEADER AZUL -->
        <HBox styleClass="cp-header" alignment="CENTER_LEFT" spacing="14">
            <FontIcon iconLiteral="mdi2r-receipt-text" iconSize="28" iconColor="white"/>
            <VBox spacing="2">
                <Label text="CONSULTAR CUPOM" styleClass="cp-header-titulo"/>
                <Label text="Pesquise vendas anteriores por período, número ou status"
                       styleClass="cp-header-sub"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="ESC para voltar" styleClass="cp-header-hint"/>
        </HBox>

        <!-- BARRA DE FILTROS -->
        <HBox styleClass="cp-busca-container" spacing="12" alignment="CENTER_LEFT">
            <padding>
                <Insets top="14" right="20" bottom="14" left="20"/>
            </padding>

            <VBox spacing="2">
                <Label text="DE" styleClass="cc-filtro-label"/>
                <DatePicker fx:id="dpDataInicio" styleClass="cc-filtro-data" prefWidth="140"/>
            </VBox>

            <VBox spacing="2">
                <Label text="ATÉ" styleClass="cc-filtro-label"/>
                <DatePicker fx:id="dpDataFim" styleClass="cc-filtro-data" prefWidth="140"/>
            </VBox>

            <VBox spacing="2">
                <Label text="Nº COO / CUPOM" styleClass="cc-filtro-label"/>
                <TextField fx:id="tfNumeroCupom" styleClass="cc-filtro-input"
                           promptText="Opcional" prefWidth="140"/>
            </VBox>

            <VBox spacing="2">
                <Label text="CPF / CNPJ CLIENTE" styleClass="cc-filtro-label"/>
                <TextField fx:id="tfCpfCnpj" styleClass="cc-filtro-input"
                           promptText="Opcional (só números)" prefWidth="180"/>
            </VBox>

            <VBox spacing="2">
                <Label text="STATUS" styleClass="cc-filtro-label"/>
                <ComboBox fx:id="cbStatus" styleClass="cc-filtro-combo" prefWidth="200"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <VBox spacing="2">
                <Label text=" " styleClass="cc-filtro-label"/>
                <Button fx:id="btnBuscar" text="BUSCAR" styleClass="cc-btn-buscar"
                        onAction="#aoClicarBuscar"/>
            </VBox>

            <VBox spacing="2">
                <Label text=" " styleClass="cc-filtro-label"/>
                <Label fx:id="lblContador" text="" styleClass="cp-busca-contador"/>
            </VBox>
        </HBox>

        <!-- CORPO 2 colunas -->
        <GridPane VBox.vgrow="ALWAYS" hgap="12">
            <padding>
                <Insets bottom="14" left="14" right="14" top="6"/>
            </padding>
            <columnConstraints>
                <ColumnConstraints percentWidth="40"/>
                <ColumnConstraints percentWidth="60"/>
            </columnConstraints>
            <rowConstraints>
                <RowConstraints vgrow="ALWAYS"/>
            </rowConstraints>

            <!-- ESQUERDA: lista -->
            <VBox styleClass="cp-card" GridPane.columnIndex="0" GridPane.rowIndex="0">
                <Label text="CUPONS ENCONTRADOS" styleClass="cp-card-titulo">
                    <VBox.margin>
                        <Insets bottom="6" left="14" right="14" top="14"/>
                    </VBox.margin>
                </Label>
                <TableView fx:id="tabelaCupons" styleClass="cp-tabela" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colCoo" prefWidth="60" minWidth="50" text="COO"/>
                        <TableColumn fx:id="colData" prefWidth="120" minWidth="100" text="DATA / HORA"/>
                        <TableColumn fx:id="colTotal" prefWidth="90" minWidth="80" text="TOTAL"/>
                        <TableColumn fx:id="colStatus" prefWidth="80" minWidth="70" text="STATUS"/>
                    </columns>
                </TableView>
            </VBox>

            <!-- DIREITA: detalhe -->
            <ScrollPane fitToWidth="true" styleClass="cp-detalhe-scroll"
                        GridPane.columnIndex="1" GridPane.rowIndex="0">
                <VBox styleClass="cp-card" spacing="14">
                    <padding>
                        <Insets top="14" right="14" bottom="14" left="14"/>
                    </padding>

                    <!-- Estado vazio -->
                    <VBox fx:id="estadoVazio" alignment="CENTER" spacing="10" styleClass="cp-vazio">
                        <FontIcon iconLiteral="mdi2r-receipt-text" iconSize="64"
                                  styleClass="cp-vazio-icone"/>
                        <Label text="Selecione um cupom" styleClass="cp-vazio-titulo"/>
                        <Label text="Os detalhes aparecem aqui ao escolher um item da lista"
                               styleClass="cp-vazio-sub" wrapText="true"/>
                    </VBox>

                    <!-- Conteúdo do detalhe -->
                    <VBox fx:id="painelInfo" spacing="14" visible="false" managed="false">

                        <!-- Cabeçalho do cupom -->
                        <VBox spacing="4">
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Label fx:id="lblNumeroCupom" text="—" styleClass="cp-nome-produto"/>
                                <Label fx:id="lblBadgeStatus" text="" styleClass="cp-badge-ativo"/>
                            </HBox>
                            <Label fx:id="lblDataHora" text="—" styleClass="cp-codigos"/>
                            <Label fx:id="lblOperadorCliente" text="—" styleClass="cp-desc"/>
                        </VBox>

                        <!-- Bloco ITENS -->
                        <VBox styleClass="cp-bloco" spacing="6">
                            <Label text="ITENS" styleClass="cp-bloco-titulo"/>
                            <TableView fx:id="tabelaItens" styleClass="cc-tabela-itens" prefHeight="200">
                                <columns>
                                    <TableColumn fx:id="colItemSeq" prefWidth="50" text="SEQ"/>
                                    <TableColumn fx:id="colItemDesc" prefWidth="180" text="DESCRIÇÃO"/>
                                    <TableColumn fx:id="colItemQtd" prefWidth="60" text="QTD"/>
                                    <TableColumn fx:id="colItemTotal" prefWidth="90" text="TOTAL"/>
                                    <TableColumn fx:id="colItemAcao" prefWidth="100" text="AÇÃO"/>
                                </columns>
                            </TableView>
                        </VBox>

                        <!-- Bloco PAGAMENTOS -->
                        <VBox fx:id="blocoPagamentos" styleClass="cp-bloco" spacing="6">
                            <Label text="PAGAMENTOS" styleClass="cp-bloco-titulo"/>
                            <VBox fx:id="containerPagamentos" spacing="4"/>
                        </VBox>

                        <!-- Bloco TOTAIS -->
                        <VBox styleClass="cp-bloco" spacing="6">
                            <Label text="TOTAIS" styleClass="cp-bloco-titulo"/>
                            <GridPane hgap="20" vgap="4">
                                <columnConstraints>
                                    <ColumnConstraints/>
                                    <ColumnConstraints/>
                                </columnConstraints>
                                <Label text="Subtotal:" styleClass="cp-bloco-label" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                                <Label fx:id="lblSubtotalDetalhe" text="—" styleClass="cp-bloco-valor"
                                       GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                                <Label text="Desconto:" styleClass="cp-bloco-label" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                                <Label fx:id="lblDescontoDetalhe" text="—" styleClass="cp-bloco-valor"
                                       GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                                <Label text="Acréscimo:" styleClass="cp-bloco-label" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                                <Label fx:id="lblAcrescimoDetalhe" text="—" styleClass="cp-bloco-valor"
                                       GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                                <Label text="Cancelado:" styleClass="cp-bloco-label" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                                <Label fx:id="lblCanceladoDetalhe" text="—" styleClass="cp-bloco-valor"
                                       GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                                <Label text="TOTAL FINAL:" styleClass="cc-total-label" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                                <Label fx:id="lblTotalFinalDetalhe" text="—" styleClass="cc-total-valor"
                                       GridPane.columnIndex="1" GridPane.rowIndex="4"/>

                                <Label text="Valor Recebido:" styleClass="cp-bloco-label" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
                                <Label fx:id="lblRecebidoDetalhe" text="—" styleClass="cp-bloco-valor"
                                       GridPane.columnIndex="1" GridPane.rowIndex="5"/>

                                <Label text="Troco:" styleClass="cp-bloco-label" GridPane.columnIndex="0" GridPane.rowIndex="6"/>
                                <Label fx:id="lblTrocoDetalhe" text="—" styleClass="cp-bloco-valor"
                                       GridPane.columnIndex="1" GridPane.rowIndex="6"/>
                            </GridPane>
                        </VBox>
                    </VBox>
                </VBox>
            </ScrollPane>
        </GridPane>

        <!-- RODAPÉ -->
        <HBox styleClass="cp-rodape" alignment="CENTER_LEFT" spacing="20">
            <padding>
                <Insets top="10" right="20" bottom="10" left="20"/>
            </padding>
            <Label text="↑↓ Navegar  ·  ENTER Selecionar  ·  ESC Voltar"
                   styleClass="cp-rodape-texto"/>
        </HBox>
    </VBox>
</AnchorPane>
