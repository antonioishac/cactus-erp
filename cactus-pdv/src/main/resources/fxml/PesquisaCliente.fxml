<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="950.0" styleClass="fundo" stylesheets="@styles/produtos.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.com.cactuserp.pdv.controllers.PesquisaClienteController">

    <VBox prefHeight="600.0" prefWidth="954.0" styleClass="painel">
        <HBox.margin>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
        </HBox.margin>
        <HBox prefHeight="33.0" prefWidth="910.0" styleClass="gradient-topo">
            <Label text="Pesquisar Clientes" textFill="WHITE" />
        </HBox>
        <VBox prefHeight="433.0" prefWidth="910.0" style="-fx-background-color: #F3F4F6;" styleClass="painel-produto">
            <VBox.margin>
                <Insets top="10.0" />
            </VBox.margin>
            <padding>
                <Insets bottom="10.0" />
            </padding>

            <Label styleClass="label-produto" text="Buscar por:">
                <VBox.margin>
                    <Insets bottom="5.0" left="10.0" top="10.0" />
                </VBox.margin>
            </Label>
            <HBox prefHeight="30.0" prefWidth="880.0">
                <VBox.margin>
                    <Insets bottom="5.0" left="10.0" />
                </VBox.margin>
                <fx:define>
                    <ToggleGroup fx:id="tgTipoBusca" />
                </fx:define>
                <RadioButton fx:id="rbNome" selected="true" text="Nome / Razão Social" toggleGroup="$tgTipoBusca">
                    <HBox.margin>
                        <Insets right="20.0" />
                    </HBox.margin>
                </RadioButton>
                <RadioButton fx:id="rbCpfCnpj" text="CPF / CNPJ" toggleGroup="$tgTipoBusca" />
            </HBox>

            <Label fx:id="lblFiltro" styleClass="label-produto" text="Nome / Razão Social:">
                <VBox.margin>
                    <Insets bottom="10.0" left="10.0" top="5.0" />
                </VBox.margin>
            </Label>
            <TextField fx:id="tfFiltro" prefHeight="32.0" prefWidth="880.0">
                <VBox.margin>
                    <Insets bottom="10.0" left="10.0" right="10.0" />
                </VBox.margin>
            </TextField>

            <TableView fx:id="tblClientes" prefHeight="290.0" prefWidth="880.0" styleClass="tabela-pdv">
                <columns>
                    <TableColumn fx:id="codigoColumn" prefWidth="70.0" text="Código" />
                    <TableColumn fx:id="nomeColumn" prefWidth="340.0" text="Nome / Razão Social" />
                    <TableColumn fx:id="cpfCnpjColumn" prefWidth="140.0" text="CPF / CNPJ" />
                    <TableColumn fx:id="tipoPessoaColumn" prefWidth="50.0" text="Tipo" />
                    <TableColumn fx:id="cidadeColumn" prefWidth="180.0" text="Cidade" />
                    <TableColumn fx:id="ufColumn" prefWidth="50.0" text="UF" />
                    <TableColumn fx:id="telefoneColumn" prefWidth="120.0" text="Telefone" />
                </columns>
                <VBox.margin>
                    <Insets left="10.0" right="10.0" />
                </VBox.margin>
            </TableView>
        </VBox>
        <HBox prefHeight="60.0" prefWidth="910.0" style="-fx-alignment: CENTER;">
            <Button fx:id="btnPesquisar" mnemonicParsing="false" styleClass="button-verde" text="[F1] - Pesquisar">
                <HBox.margin>
                    <Insets right="10.0" top="10.0" />
                </HBox.margin>
            </Button>
            <Button fx:id="btnSelecionar" mnemonicParsing="false" styleClass="button-verde" text="[F2] - Selecionar">
                <HBox.margin>
                    <Insets right="10.0" top="10.0" />
                </HBox.margin>
            </Button>
            <Button fx:id="btnCancelar" mnemonicParsing="false" styleClass="button-vermelho" text="[F10] - Cancelar">
                <HBox.margin>
                    <Insets top="10.0" />
                </HBox.margin>
            </Button>
        </HBox>
    </VBox>
</HBox>