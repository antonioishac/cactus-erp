# URLs base dos backends consumidos pelo cactus-erp-web.
# Copie este arquivo para .env.development (não versionado) e ajuste se necessário.
# Ver cactus-erp-web/CLAUDE.md, seção "Como rodar localmente".

# seguranca-service — Authorization Server (OIDC) + API de sessão (/api/v1/auth/**)
VITE_SEGURANCA_API_URL=http://localhost:8082

# cadastro-base-service — cadastros base (produto, cliente, empresa, tributação...)
VITE_CADASTRO_BASE_API_URL=http://localhost:8081

# controle-estoque-service — depósitos, saldo, movimentos, transferências...
VITE_ESTOQUE_API_URL=http://localhost:8083

# gestao-documentos-service — GED: documentos, versões, pastas, tipos de documento
VITE_GED_API_URL=http://localhost:8085

# gestao-compras-service — requisição, cotação, pedido, recebimento de compra
VITE_COMPRAS_API_URL=http://localhost:8084

# business-intelligence-service — indicadores (snapshots do ETL) + disparo manual de ETL
VITE_BI_API_URL=http://localhost:8086

# vendas-service — Vendedor/Comissão/AFV, Condições de Pagamento, Orçamento, Venda/Frete
VITE_VENDAS_API_URL=http://localhost:8088

# fiscal-service — NF-e/CT-e/NFS-e a partir de Venda/OS (ponte ACBr)
VITE_FISCAL_API_URL=http://localhost:8089

# os-service — Ordem de Serviço: abertura, equipamentos, itens, evolução
VITE_OS_API_URL=http://localhost:8090

# crm-service — Lead/Oportunidade (funil), Atividade/Interação
VITE_CRM_API_URL=http://localhost:8091

# financeiro-service — Contas a Receber/Pagar, Caixa e Bancos, Tesouraria, Conciliação, EDI Bancário
VITE_FINANCEIRO_API_URL=http://localhost:8093

# contabilidade-service — Plano de Contas, Centro de Custo, Lançamento Contábil, Balancete/Razão
VITE_CONTABILIDADE_API_URL=http://localhost:8094

# loja-virtual-service — admin da plataforma: Lojas, Categorias/Atributos, Produtos/Variantes, Pedidos
VITE_LOJA_API_URL=http://localhost:8092

# sincronizacao-service — camada anticorrupção ERP↔PDV: lotes/registros de sincronização, reprocessamento
VITE_SINCRONIZACAO_API_URL=http://localhost:8087
